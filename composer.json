{
    "name": "pdftoolkit/html-to-pdf",
    "type": "library",
    "description": "Object-oriented HTML and CSS pagination to tagged PDF in native PHP",
    "license": "MIT",
    "authors": [
        {
            "name": "Mathias STRASSER",
            "email": "contact@roukmoute.fr"
        }
    ],
    "require": {
        "php": "^8.3",
        "php-64bit": "*",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "masterminds/html5": "^2.10",
        "sabberworm/php-css-parser": "^9.0",
        "symfony/css-selector": "^7.3",
        "roukmoute/pdf": "^0.12.1",
        "pdftoolkit/pdf-fonts": "^0.2",
        "pdftoolkit/pdf-images": "^0.2.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.0",
        "pdftoolkit/pdf-reader": "^0.8"
    },
    "autoload": {
        "psr-4": {
            "PDF\\HtmlToPdf\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PDF\\HtmlToPdf\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "@php -d memory_limit=512M vendor/bin/phpunit --fail-on-deprecation",
        "analyse": "phpstan analyse --no-progress",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff --using-cache=no",
        "check": [
            "@test",
            "@analyse",
            "@format:check"
        ]
    },
    "support": {
        "issues": "https://github.com/PDFToolkit/html-to-pdf/issues",
        "source": "https://github.com/PDFToolkit/html-to-pdf"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
